# Project Configuration
PROJECT_NAME="AI Image Understanding & Content Matching Engine"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=image_matching_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/image_matching_db

# Security & JWT
SECRET_KEY=dev-secret-key-change-in-production-1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Provider Configuration
GEMINI_API_KEY=your-gemini-api-key-here

# Storage Paths
STORAGE_BASE_DIR=storage
LOG_LEVEL=INFO
